# Copiá este archivo como .env (en la raíz del repo) y ajustá lo que necesites.
# Lo usan docker compose (para crear la base) y el backend (para conectarse).
# El .env NO se sube a GitHub: está en .gitignore.

DB_NAME=adoptar
DB_USER=adoptar
DB_PASSWORD=adoptar
DB_HOST=localhost
# Si ya tenés un PostgreSQL instalado que ocupa el 5432, usá otro (por ejemplo 5433)
DB_PORT=5432
